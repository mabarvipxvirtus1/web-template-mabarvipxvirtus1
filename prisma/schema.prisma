generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Player {
  id            String   @id @default(uuid())
  name          String
  gameId        String   @default("")
  vipType       String
  status        String
  matchesPlayed Int      @default(0)
  matchesTotal  Int      @default(0)
  queueOrder    Int      @default(0)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SystemSetting {
  id           String   @id @default("settings")
  isLive       Boolean  @default(false)
  streamTitle  String   @default("Mabar VIP Stream!")
  streamUrl    String   @default("")
  sociabuzz    String   @default("")
  announcement String   @default("Welcome to the stream! Join VIP to play next.")
  updatedAt    DateTime @updatedAt
}

model LinktreeProfile {
  id                      String              @id @default("profile")
  name                    String              @default("Virtus Official")
  bio                     String              @default("Streamer TIDAK KIKIR | Mobile Legends & Gaming Content Creator 🔥")
  avatarUrl               String              @default("/logo.png")
  theme                   String              @default("ocean")
  socialHeaderTitle       String              @default("Social Media Handles")
  showLiveBanner          Boolean             @default(true)
  liveBannerTitle         String              @default("Cupidut & Dudud Lovers")
  liveBannerSub           String              @default("Galeri album foto eksklusif dua kucing kesayangan Virtus")
  liveBannerUrl           String              @default("/fanbase-cupidut-dudud")
  liveBannerImage         String              @default("https://images.unsplash.com/photo-1616588589676-63b3bd49651c?w=600&auto=format&fit=crop&q=80")
  updatedAt               DateTime            @updatedAt
  avatarBorderColor       String              @default("from-cyan-400 via-indigo-500 to-purple-500")
  footerDesc              String              @default("Platform resmi Virtus Official. Dapatkan akses ke game streaming eksklusif, antrean VIP real-time, dan tautan sosial media resmi kami.")
  siteLogoUrl             String              @default("")
  siteSubtitle            String              @default("Streamer TIDAK KIKIR")
  siteTitle               String              @default("Virtus Official")
  faviconUrl              String              @default("")
  categoryBgColor         String              @default("")
  categoryTextColor       String              @default("")
  leaderboardMode         String              @default("top3")
  leaderboardTitle        String              @default("TOP SUPPORTERS BULAN INI")
  showLeaderboard         Boolean             @default(true)
  sociabuzzTribeId        String              @default("8913094574")
  leaderboardHeaderColor  String              @default("")
  leaderboardHeaderFont   String              @default("sans")
  leaderboardHeaderIcon   String              @default("trophy")
  leaderboardHeaderSize   String              @default("2xl")
  leaderboardUrl          String              @default("https://sociabuzz.com/pro/tribe/topleaderboard/v2/8913094574")
  showVideoAd             Boolean             @default(false)
  videoAdChromaColor      String              @default("#00FF00")
  videoAdChromaEnable     Boolean             @default(true)
  videoAdChromaSimilarity Float               @default(0.35)
  videoAdChromaSmoothness Float               @default(0.1)
  videoAdOffsetX          Int                 @default(20)
  videoAdOffsetY          Int                 @default(20)
  videoAdPosition         String              @default("bottom-right")
  videoAdTargetUrl        String              @default("")
  videoAdUrl              String              @default("")
  videoAdWidth            Int                 @default(180)
  videoAdZIndex           Int                 @default(50)
  videoAdWidthDesktop     Int                 @default(180)
  videoAdWidthMobile      Int                 @default(120)
  showSocialHeaderIcons   Boolean             @default(true)
  socialIconBg            String              @default("glass")
  socialIconColor         String              @default("")
  socialIconGap           String              @default("md")
  socialIconPosition      String              @default("under_bio")
  socialIconSize          String              @default("md")
  socialIconUseBrandColor Boolean             @default(false)
  bgBlur                  Int                 @default(0)
  bgDarkness              Int                 @default(40)
  bgEffect                String              @default("none")
  bgEffectSpeed           String              @default("normal")
  bgImageUrl              String              @default("")
  videoAdHideClose        Boolean             @default(false)
  bannerHeight            Int                 @default(260)
  bannerImageUrl          String              @default("")
  showBannerImage         Boolean             @default(false)
  bannerOffsetTop         Int                 @default(0)
  bannerOpacity           Int                 @default(50)
  bannerObjectX           Int                 @default(50)
  bannerObjectY           Int                 @default(50)
  tiktokLiveUrl           String              @default("https://www.tiktok.com/@onlyvirtus/live")
  banners                 LinktreeBanner[]
  codes                   LinktreeCode[]
  links                   LinktreeLink[]
  topButtons              LinktreeTopButton[]
  videoAds                LinktreeVideoAd[]
}

model LinktreeLink {
  id                String          @id @default(uuid())
  title             String
  url               String
  icon              String          @default("globe")
  category          String          @default("social")
  isEnabled         Boolean         @default(true)
  orderIndex        Int             @default(0)
  profileId         String          @default("profile")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sectionTitle      String          @default("")
  sectionBgColor    String          @default("")
  sectionTextColor  String          @default("")
  waCustomMessage   String          @default("")
  customIconUrl     String          @default("")
  iconWidth         Int             @default(48)
  itemAlign         String          @default("left")
  layout            String          @default("row")
  textAlign         String          @default("left")
  showInHeaderIcons Boolean         @default(true)
  animation         String          @default("none")
  animationSpeed    String          @default("normal")
  animationStrength Int             @default(5)
  bgImageUrl        String          @default("")
  bgOpacity         Int             @default(100)
  iconShadow        String          @default("none")
  textShadow        String          @default("none")
  animationCount    Int             @default(3)
  badgeBgColor      String          @default("rgba(6, 182, 212, 0.25)")
  badgeText         String          @default("")
  badgeTextColor    String          @default("#22D3EE")
  bannerHeight      Int             @default(185)
  borderColor       String          @default("rgba(255, 255, 255, 0.2)")
  borderStyle       String          @default("rounded-3xl")
  btnText           String          @default("Kunjungi")
  btnTextColor      String          @default("#22D3EE")
  itemType          String          @default("link")
  mediaType         String          @default("image")
  overlayDarkness   Int             @default(60)
  subtitle          String          @default("")
  videoUrl          String          @default("")
  profile           LinktreeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LinktreeBanner {
  id              String          @id @default(uuid())
  title           String          @default("Judul Banner")
  subtitle        String          @default("Deskripsi singkat banner")
  badgeText       String          @default("LIVE / QUEUE")
  targetUrl       String          @default("/mabarvip")
  imageUrl        String          @default("https://images.unsplash.com/photo-1616588589676-63b3bd49651c?w=600&auto=format&fit=crop&q=80")
  isEnabled       Boolean         @default(true)
  orderIndex      Int             @default(0)
  profileId       String          @default("profile")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  badgeBgColor    String          @default("rgba(6, 182, 212, 0.25)")
  badgeTextColor  String          @default("#22D3EE")
  borderColor     String          @default("rgba(255, 255, 255, 0.2)")
  borderStyle     String          @default("rounded-3xl")
  btnText         String          @default("Kunjungi")
  btnTextColor    String          @default("#22D3EE")
  height          Int             @default(180)
  mediaType       String          @default("image")
  overlayDarkness Int             @default(60)
  subtitleColor   String          @default("#CBD5E1")
  titleColor      String          @default("#FFFFFF")
  titleSize       String          @default("lg")
  videoUrl        String          @default("")
  profile         LinktreeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LinktreeTopButton {
  id            String          @id @default(uuid())
  title         String          @default("Mabar VIP")
  url           String          @default("/mabarvip")
  icon          String          @default("gamepad")
  isShareAction Boolean         @default(false)
  isEnabled     Boolean         @default(true)
  orderIndex    Int             @default(0)
  profileId     String          @default("profile")
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  profile       LinktreeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LinktreeCode {
  id         String          @id @default(uuid())
  title      String          @default("Kode Sensitivitas")
  code       String          @default("7284-9102-1827-0192")
  isEnabled  Boolean         @default(true)
  orderIndex Int             @default(0)
  profileId  String          @default("profile")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  profile    LinktreeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model LinktreeVideoAd {
  id               String          @id @default(uuid())
  title            String          @default("Iklan Video")
  videoUrl         String          @default("")
  targetUrl        String          @default("")
  chromaEnable     Boolean         @default(true)
  chromaColor      String          @default("#00FF00")
  chromaSimilarity Float           @default(0.35)
  chromaSmoothness Float           @default(0.1)
  isEnabled        Boolean         @default(true)
  orderIndex       Int             @default(0)
  profileId        String          @default("profile")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  profile          LinktreeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model FanbaseCat {
  id          String   @id
  catType     String
  title       String
  description String   @default("")
  imageUrl    String
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}
